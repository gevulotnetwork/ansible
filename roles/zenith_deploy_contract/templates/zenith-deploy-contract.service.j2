[Unit]
Description="Deploy Zenith contract on Canton"
Requires=canton-network-setup.service
Wants=zenith-block-builder-1.service
After=canton-network-setup.service zenith-block-builder-1.service
PartOf=zenith.target

[Service]
Type=oneshot
ExecStart=%h/canton/bin/deploy-contract
RemainAfterExit=yes

[Install]
WantedBy=zenith.target
