[Unit]
Description=Canton Sequencer and Mediator
Documentation=https://docs.daml.com/canton/
After=network.target canton-postgres-init.service
Requires=canton-postgres-init.service
PartOf=zenith.target

[Service]
Type=simple
WorkingDirectory=%h/canton

ExecStart=/usr/bin/java \
    -Xmx{{ canton_java_xmx }} \
    -jar %h/canton/lib/canton.jar \
    daemon \
    -c %h/canton/configs/{{ canton_sequencer_mediator_config }} \
    --log-file-name=%h/canton/logs/sequencer-mediator.log

Restart=on-failure
RestartSec=10
TimeoutStartSec=120
TimeoutStopSec=30

LimitNOFILE={{ canton_nofile_limit }}
LimitNPROC={{ canton_nproc_limit }}

[Install]
WantedBy=zenith.target
