# Vector configuration for Gevulot node monitoring

data_dir = "{{ vector_data_dir }}"

# ─────────────────────────────────────────────────────────
# SOURCES
# ─────────────────────────────────────────────────────────

# Vector self-monitoring
[sources.vector_internal_metrics]
type = "internal_metrics"
scrape_interval_secs = 60

# Node exporter metrics (prometheus-node-exporter)
[sources.node_exporter_metrics]
type = "prometheus_scrape"
endpoints = ["http://localhost:9100/metrics"]
scrape_interval_secs = 60

# Canton service metrics (Prometheus endpoints exposed by Canton JVM processes)
{% for svc in canton_services | default([]) %}
{% if svc.metrics_port is defined %}
[sources.canton_{{ svc.name | replace('-', '_') }}_metrics]
type = "prometheus_scrape"
endpoints = ["http://localhost:{{ svc.metrics_port }}/metrics"]
scrape_interval_secs = 60
{% endif %}
{% endfor %}

# Canton service logs (collected per-service from journald)
{% for svc in canton_services | default([]) %}
[sources.canton_{{ svc.name | replace('-', '_') }}_logs]
type = "journald"
include_units = ["{{ svc.name }}.service"]
{% endfor %}

# Systemd journal logs
[sources.journald_logs]
type = "journald"
include_units = ["*.service"]

# ─────────────────────────────────────────────────────────
# TRANSFORMS
# ─────────────────────────────────────────────────────────

# Add instance label to node exporter metrics
[transforms.label_node_exporter_metrics]
type = "remap"
inputs = ["node_exporter_metrics"]
source = '''
.tags.chain_id = "{{ chain_id }}"
.tags.network = "{{ network }}"
.tags.region = "{{ region }}"
.tags.node_id = "{{ node_id }}"
.tags.instance = "{{ fqdn }}"
.tags.job = "node-exporter"
'''

# Add labels to Canton service metrics
{% for svc in canton_services | default([]) %}
{% if svc.metrics_port is defined %}
[transforms.label_canton_{{ svc.name | replace('-', '_') }}_metrics]
type = "remap"
inputs = ["canton_{{ svc.name | replace('-', '_') }}_metrics"]
source = '''
.tags.chain_id = "{{ chain_id }}"
.tags.network = "{{ network }}"
.tags.region = "{{ region }}"
.tags.node_id = "{{ node_id }}"
.tags.instance = "{{ fqdn }}"
.tags.canton_service = "{{ svc.name }}"
.tags.canton_service_type = "{{ svc.type }}"
.tags.job = "canton-{{ svc.type }}"
'''
{% endif %}
{% endfor %}

# Add instance label to Vector internal metrics
[transforms.label_vector_internal_metrics]
type = "remap"
inputs = ["vector_internal_metrics"]
source = '''
.tags.instance = "{{ fqdn }}"
.tags.job = "integrations/vector-check"
'''

# Filter Vector internal metrics to only keep relevant ones
[transforms.filter_vector_internal_metrics]
type = "filter"
inputs = ["label_vector_internal_metrics"]
condition = '''
match(to_string(.name) ?? "", r'^(vector_|component_|buffer_)')
'''

# Add labels to Canton service logs
{% for svc in canton_services | default([]) %}
[transforms.label_canton_{{ svc.name | replace('-', '_') }}_logs]
type = "remap"
inputs = ["canton_{{ svc.name | replace('-', '_') }}_logs"]
source = '''
.canton_service = "{{ svc.name }}"
.canton_service_type = "{{ svc.type }}"
.instance = "{{ fqdn }}"
.component = "canton"
.unit = "{{ svc.name }}.service"
'''
{% endfor %}

# Add labels to journal logs
[transforms.label_journald_logs]
type = "remap"
inputs = ["journald_logs"]
source = '''
.unit = ._SYSTEMD_UNIT ?? ""
.instance = "{{ fqdn }}"
.component = "vector.source.journald"
'''

# ─────────────────────────────────────────────────────────
# SINKS
# ─────────────────────────────────────────────────────────

# Send metrics to Grafana Cloud via Prometheus remote write
[sinks.grafana_prometheus]
type = "prometheus_remote_write"
inputs = [
  "label_node_exporter_metrics",
  "filter_vector_internal_metrics",
{% for svc in canton_services | default([]) %}
{% if svc.metrics_port is defined %}
  "label_canton_{{ svc.name | replace('-', '_') }}_metrics",
{% endif %}
{% endfor %}
]
endpoint = "{{ grafana_vector.metrics_service.url }}"

[sinks.grafana_prometheus.auth]
strategy = "basic"
user = "{{ grafana_vector.metrics_service.auth.username }}"
password = "{{ grafana_vector.metrics_service.auth.password }}"

# Send logs to Grafana Cloud Loki
[sinks.grafana_loki]
type = "loki"
inputs = [
  "label_journald_logs",
{% for svc in canton_services | default([]) %}
  "label_canton_{{ svc.name | replace('-', '_') }}_logs",
{% endfor %}
]
endpoint = "{{ grafana_vector.loki_service.url }}"
encoding.codec = "json"

[sinks.grafana_loki.auth]
strategy = "basic"
user = "{{ grafana_vector.loki_service.auth.username }}"
password = "{{ grafana_vector.loki_service.auth.password }}"

[sinks.grafana_loki.labels]
unit = "{{ '{{' }} unit {{ '}}' }}"
instance = "{{ '{{' }} instance {{ '}}' }}"
component = "{{ '{{' }} component {{ '}}' }}"
canton_service = "{{ '{{' }} canton_service {{ '}}' }}"
canton_service_type = "{{ '{{' }} canton_service_type {{ '}}' }}"
