// Zenith EVM — Deploy ZeoRules + genesis Block
//
// Parties (must already exist from setup-network):
//   zeo: decentralized namespace (owned by participant1, hosted on all 3)
//   participant1: Validator1
//   participant2: Validator2
//   participant3: Validator3

import com.daml.ledger.api.v2.value._
import com.daml.ledger.api.v2.commands._
import com.google.protobuf.empty.Empty

println("=" * 60)
println("Zenith EVM — Deploy Contracts")
println("=" * 60)

// ── Helpers ──────────────────────────────────────────────────────────────────
val unitV = Value(Value.Sum.Unit(Empty()))
def partyV(p: com.digitalasset.canton.topology.PartyId) = Value(Value.Sum.Party(p.toProtoPrimitive))
def intV(n: Long) = Value(Value.Sum.Int64(n))
def textV(s: String) = Value(Value.Sum.Text(s))
def boolV(b: Boolean) = Value(Value.Sum.Bool(b))
def numericV(s: String) = Value(Value.Sum.Numeric(s))
// U64 is newtype U64 = U64 (Numeric 0) — not transparent in LF 2.dev
def u64V(n: Long) = recV("" -> numericV(n.toString))
val optNone = Value(Value.Sum.Optional(Optional(None)))
def listV(vs: Value*) = Value(Value.Sum.List(com.daml.ledger.api.v2.value.List(vs)))
def recV(fields: (String, Value)*) =
  Value(Value.Sum.Record(Record(fields = fields.map { case (n, v) => RecordField(n, Some(v)) })))
def varV(tag: String, v: Value) = Value(Value.Sum.Variant(Variant(constructor = tag, value = Some(v))))
def enumV(tag: String) = Value(Value.Sum.Enum(com.daml.ledger.api.v2.value.Enum(constructor = tag)))
def genMapV(entries: (Value, Value)*) =
  Value(Value.Sum.GenMap(GenMap(entries = entries.map { case (k, v) => GenMap.Entry(Some(k), Some(v)) })))

// Set Party helper: DA.Set.Set is a record { map : GenMap Party () }
def setV(entries: (Value, Value)*) = recV("map" -> genMapV(entries: _*))
def emptySetV = recV("map" -> genMapV())

// ── Phase 1: Resolve parties ─────────────────────────────────────────────────
println("\n[Phase 1] Resolving parties...")

val synchronizerId = participant1.synchronizers.id_of(SynchronizerAlias.tryCreate("da"))

def findParty(p: com.digitalasset.canton.console.ParticipantReference, name: String) =
  p.parties.list().find(_.party.toProtoPrimitive.startsWith(s"$name::"))
    .getOrElse(sys.error(s"Party '$name' not found — run setup-network first")).party

print("  zeo ... ")
val zeo = findParty(participant1, "zeo")
println(s"$zeo")

print("  Validator1 ... ")
val validator1 = findParty(participant1, "Validator1")
println(s"$validator1")

print("  Validator2 ... ")
val validator2 = findParty(participant2, "Validator2")
println(s"$validator2")

print("  Validator3 ... ")
val validator3 = findParty(participant3, "Validator3")
println(s"$validator3")

print("  Zenith.Evm package ... ")
val pkg = participant1.packages.find_by_module("Zenith.Evm.Rules").headOption
  .getOrElse(sys.error("Zenith.Evm package not found — upload zenith-evm DAR first"))
println(s"${pkg.packageId}")

// Address is now BytesHex (plain text), not a record
val zeroAddr = textV("0000000000000000000000000000000000000000")
val chainId = recV("zeo" -> partyV(zeo), "version" -> textV(""))

// ── Phase 1b: Wait for Ledger API submission readiness ─────────────────────
// The topology (party-to-participant mapping) may take time to propagate
// from the admin API to the Ledger API after network-setup completes.
print("  Verifying ZEO submission readiness... ")
var _submissionReady = false
var _submissionAttempt = 0
while (!_submissionReady && _submissionAttempt < 60) {
  try {
    // Check topology is visible via admin API with all participants
    val mappings = participant1.topology.party_to_participant_mappings
      .list(synchronizerId, filterParty = zeo.filterString)
    val hasAllParticipants = mappings.exists(_.item.participants.size >= 3)
    if (!hasAllParticipants) {
      throw new RuntimeException("Mapping not yet complete")
    }
    // Try to verify the Ledger API knows about the party
    val acs = participant1.ledger_api.state.acs.of_party(zeo)
    _submissionReady = true
  } catch {
    case _: Throwable =>
      if (_submissionAttempt % 10 == 0 && _submissionAttempt > 0) print(".")
      Thread.sleep(5000)
      _submissionAttempt += 1
  }
}
if (!_submissionReady) sys.error("ZEO submission readiness timed out after 5 minutes")
println(s"ready (${_submissionAttempt * 5}s)")

// ── Phase 2: ZeoRules ────────────────────────────────────────────────────────
println("\n[Phase 2] Deploying ZeoRules...")

val existingRules = participant1.ledger_api.state.acs.of_party(zeo)
  .find(_.templateId.toString.contains("ZeoRules"))

if (existingRules.nonEmpty) {
  println("  ZeoRules already exists — skipping.")
} else {
  print("  ZEO: creating ZeoRules ... ")

  // Validators: Map U64 Validator (U64 = newtype around Numeric 0)
  val zeoRulesValue = recV(
    "chainId"      -> chainId,
    "proposers"    -> setV(
      (partyV(validator1), unitV)
    ),
    "validators"   -> genMapV(
      (u64V(0), recV(
        "index"      -> u64V(0),
        "ethAddress"  -> zeroAddr,
        "party"      -> partyV(validator1)
      )),
      (u64V(1), recV(
        "index"      -> u64V(1),
        "ethAddress"  -> zeroAddr,
        "party"      -> partyV(validator2)
      )),
      (u64V(2), recV(
        "index"      -> u64V(2),
        "ethAddress"  -> zeroAddr,
        "party"      -> partyV(validator3)
      ))
    ),
    "blockBuilder" -> enumV("EcsBlockBuilder"),
    "observers"    -> emptySetV
  )

  val templateId = Identifier(
    packageId = pkg.packageId,
    moduleName = "Zenith.Evm.Rules",
    entityName = "ZeoRules"
  )

  val createCmd = Command(Command.Command.Create(CreateCommand(
    templateId = Some(templateId),
    createArguments = zeoRulesValue.sum.record.map(Some(_)).getOrElse(None)
  )))

  // Retry submit — Ledger API may need time to sync topology from admin API.
  // CommandFailure wraps gRPC errors; getMessage() is generic, so catch all.
  var _submitted = false
  var _retries = 0
  while (!_submitted && _retries < 30) {
    try {
      participant1.ledger_api.commands.submit(
        actAs = Seq(zeo),
        commands = Seq(createCmd),
        synchronizerId = Some(synchronizerId),
      )
      _submitted = true
    } catch {
      case _: Throwable if _retries < 29 =>
        print(s"retry(${_retries + 1})... ")
        Thread.sleep(10000)
        _retries += 1
    }
  }
  if (!_submitted) sys.error("ZeoRules submit failed after 30 retries")
  Thread.sleep(2000)
  println("done")
}

val rulesContract = participant1.ledger_api.state.acs.of_party(zeo)
  .find(_.templateId.toString.contains("ZeoRules"))
  .getOrElse(sys.error("ZeoRules not found after deployment"))
println(s"  Contract ID: ${rulesContract.contractId}")

// ── Phase 3: Genesis Block ───────────────────────────────────────────────────
println("\n[Phase 3] Deploying genesis Block...")

val existingBlock = participant1.ledger_api.state.acs.of_party(zeo)
  .find(c => {
    val t = c.templateId.toString
    t.contains("Block") && !t.contains("BlockProposal") && !t.contains("BlockBuilder")
  })

if (existingBlock.nonEmpty) {
  println("  Block already exists — skipping.")
} else {
  val genesisBlockHash = sys.props.getOrElse("genesis.hash",
    sys.error("genesis.hash system property required — pass -Dgenesis.hash=..."))

  print("  ZEO: creating genesis Block ... ")

  // Block template: chainId, hash (B256=text), beaconState, observers
  // BeaconState: balances (Map U64 U64), withdrawalIndex (Int)
  val blockValue = recV(
    "chainId" -> chainId,
    "hash" -> textV(genesisBlockHash),
    "beaconState" -> recV(
      "balances"        -> genMapV(
        (u64V(0), u64V(0)),
        (u64V(1), u64V(0)),
        (u64V(2), u64V(0))
      ),
      "withdrawalIndex" -> intV(0)
    ),
    "observers" -> emptySetV
  )

  val blockTemplateId = Identifier(
    packageId = pkg.packageId,
    moduleName = "Zenith.Evm.Block",
    entityName = "Block"
  )

  val blockCreateCmd = Command(Command.Command.Create(CreateCommand(
    templateId = Some(blockTemplateId),
    createArguments = blockValue.sum.record.map(Some(_)).getOrElse(None)
  )))

  participant1.ledger_api.commands.submit(
    actAs = Seq(zeo),
    commands = Seq(blockCreateCmd),
    synchronizerId = Some(synchronizerId),
  )
  Thread.sleep(3000)
  println("done")
}

val blockContract = participant1.ledger_api.state.acs.of_party(zeo)
  .find(c => {
    val t = c.templateId.toString
    t.contains("Block") && !t.contains("BlockProposal") && !t.contains("BlockBuilder")
  })
  .getOrElse(sys.error("Block not found after deployment"))
println(s"  Contract ID: ${blockContract.contractId}")

// ── Phase 4: BlockProposals ──────────────────────────────────────────────────
println("\n[Phase 4] Deploying BlockProposals...")

val proposalTemplateId = Identifier(
  packageId = pkg.packageId,
  moduleName = "Zenith.Evm.Rules",
  entityName = "BlockProposal"
)

def createBlockProposal(
  p: com.digitalasset.canton.console.ParticipantReference,
  proposer: com.digitalasset.canton.topology.PartyId,
  name: String
): Unit = {
  val existing = p.ledger_api.state.acs.of_party(proposer)
    .find(_.templateId.toString.contains("BlockProposal"))

  if (existing.nonEmpty) {
    println(s"  $name BlockProposal already exists — skipping.")
  } else {
    print(s"  $name: creating BlockProposal ... ")

    val proposalValue = recV(
      "chainId"      -> chainId,
      "proposer"     -> partyV(proposer),
      "transactions" -> listV(),
      "withdrawals"  -> listV(),
      "observers"    -> setV((partyV(proposer), unitV))
    )

    val createCmd = Command(Command.Command.Create(CreateCommand(
      templateId = Some(proposalTemplateId),
      createArguments = proposalValue.sum.record.map(Some(_)).getOrElse(None)
    )))

    p.ledger_api.commands.submit(
      actAs = Seq(proposer),
      commands = Seq(createCmd),
      synchronizerId = Some(synchronizerId),
    )
    Thread.sleep(2000)
    println("done")
  }
}

createBlockProposal(participant1, validator1, "Validator1")

// ── Phase 5: Write environment file for downstream services ─────────────────
val envPath = Option(System.getProperty("env.path"))
  .getOrElse(sys.props.getOrElse("user.home", "/home/canton") + "/canton/scripts/zenith-parties.env")
println(s"\n[Phase 5] Writing environment file: $envPath")

val envContent = Seq(
  s"ZENITH_ZEO_PARTY=${zeo.toProtoPrimitive}",
  s"ZENITH_VALIDATOR1_PARTY=${validator1.toProtoPrimitive}",
  s"ZENITH_VALIDATOR2_PARTY=${validator2.toProtoPrimitive}",
  s"ZENITH_VALIDATOR3_PARTY=${validator3.toProtoPrimitive}",
  s"ZENITH_PACKAGE_ID=${pkg.packageId}",
  s"ZENITH_ZEORULES_CONTRACT_ID=${rulesContract.contractId}",
  s"ZENITH_BLOCK_CONTRACT_ID=${blockContract.contractId}"
).mkString("\n")

val writer = new java.io.PrintWriter(new java.io.File(envPath))
writer.println(envContent)
writer.close()
println("  done")

// ── Phase 6: Raise confirming threshold to 2 ────────────────────────────────
// Now that all contracts are deployed and the Ledger API has synced the
// topology, raise the party-to-participant confirming threshold from 1 to 2
// for operational decentralization (2/3 participants must confirm txns).
println("\n[Phase 6] Raising ZEO confirming threshold to 2...")

val finalPartyMapping: Seq[(com.digitalasset.canton.topology.ParticipantId, ParticipantPermission)] = Seq(
  (participant1.id, ParticipantPermission.Submission),
  (participant2.id, ParticipantPermission.Submission),
  (participant3.id, ParticipantPermission.Submission),
)

// Only participant1 needs to propose — it's the sole namespace owner.
// Hosting consents from participant2/3 carry forward from setup-network.
try {
  participant1.topology.party_to_participant_mappings.propose(
    zeo, finalPartyMapping, PositiveInt.tryCreate(2),
    store = synchronizerId, mustFullyAuthorize = false,
  )
  print("  participant1 proposed... ")
} catch { case _: Throwable => print("  (already at threshold=2) ") }

utils.retry_until_true(timeout = 2.minutes) {
  val mappings = participant1.topology.party_to_participant_mappings
    .list(synchronizerId, filterParty = zeo.filterString)
  mappings.exists(m => m.item.participants.size >= 3 && m.item.threshold.value == 2)
}
println("  Confirming threshold raised to 2.")

// ── Summary ──────────────────────────────────────────────────────────────────
println("\n" + "=" * 60)
println("Contracts deployed.")
println("=" * 60)
println(s"\n  ZeoRules:  ${rulesContract.contractId}")
println(s"  Block:     ${blockContract.contractId}")
println(s"\n  Roles:")
println(s"    ZEO:         $zeo")
println(s"    Validator1:  $validator1")
println(s"    Validator2:  $validator2")
println(s"    Validator3:  $validator3")
println(s"\n  Block builder: EcsBlockBuilder (via zenith-ecs)")
